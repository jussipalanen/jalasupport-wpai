# -----------------------------------------------------------------------------
# Azure free-tier deployment settings for scripts/azure/*.sh
# Copy to scripts/azure/config.env (git-ignored) and adjust.
# -----------------------------------------------------------------------------

# Subscription (leave empty to use the current `az account` subscription)
AZ_SUBSCRIPTION=""

# Region: must offer Azure Container Apps and MySQL Flexible Server B1ms
AZ_LOCATION="northeurope"

# Everything is created in this resource group, so teardown is one command
AZ_RESOURCE_GROUP="rg-jalasupport"

# Prefix for resource names (lowercase letters and digits, 3-14 characters)
AZ_PREFIX="jalasupport"

# Budget alert (strongly recommended). Leave BUDGET_EMAIL empty to skip.
BUDGET_AMOUNT="5"
BUDGET_EMAIL=""

# Database (Azure Database for MySQL Flexible Server, Burstable B1ms)
MYSQL_VERSION="8.0.21"
MYSQL_ADMIN_USER="jalaadmin"

# AI (optional). Leave GEMINI_API_KEY empty to deploy without AI features.
# The key is stored as a Container Apps secret. Free-tier keys from Google AI
# Studio: Google may use submitted content to improve its products.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
AI_DAILY_LIMIT="200"

# Container size (0.5 vCPU / 1 GiB fits the Container Apps free grant)
APP_CPU="0.5"
APP_MEMORY="1Gi"

# Minimum replicas: 0 scales to zero when idle (free grant, a few seconds of
# cold start after idle periods); 1 keeps one replica running (no cold
# starts, roughly $10 a month at 0.5 vCPU / 1 GiB)
APP_MIN_REPLICAS="0"

# Custom domain (optional), e.g. support.example.com. Add it first with
# ./dev azure domain add <hostname>; setup.sh then keeps it.
APP_DOMAIN=""
