# -----------------------------------------------------------------------------
# JalaSupport AI environment configuration
# Copy to .env and adjust. Never commit .env.
# -----------------------------------------------------------------------------

# Database (Docker Compose uses these to create the MySQL database and user)
DB_NAME='jalasupport'
DB_USER='jalasupport'
DB_PASSWORD='change-me'
DB_ROOT_PASSWORD='change-me-root'
# DB_HOST is forced to "db" inside Docker Compose. Set it for non-Docker setups.
# DB_HOST='127.0.0.1'
# DB_PREFIX='wp_'
# DB_SSL=true   # Required for Azure Database for MySQL

# Optionally use a DSN instead of the individual DB_* variables
# DATABASE_URL='mysql://user:password@host:3306/database'

WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Azure OpenAI (optional; AI features are disabled until configured)
# Endpoint format: https://<resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=''
AZURE_OPENAI_API_KEY=''
AZURE_OPENAI_DEPLOYMENT=''
# AZURE_OPENAI_API_VERSION='2024-10-21'
# Use the App Service managed identity instead of an API key
# AZURE_OPENAI_USE_MANAGED_IDENTITY=false
# AZURE_OPENAI_TIMEOUT=30

# Docker Compose (optional)
# APP_PORT=8080
# DB_PORT=3306
# HOST_UID=1000
# HOST_GID=1000
