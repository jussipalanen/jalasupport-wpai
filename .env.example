# -----------------------------------------------------------------------------
# JalaSupport AI environment configuration
# Copy to .env and adjust. Never commit .env.
# -----------------------------------------------------------------------------

# Database (Docker Compose uses these to create the MySQL database and user)
DB_NAME='jalasupport'
DB_USER='jalasupport'
DB_PASSWORD='change-me'
DB_ROOT_PASSWORD='change-me-root'
# Inside Docker Compose the app container always uses DB_HOST=db. Set DB_HOST to
# 127.0.0.1 to run WP-CLI from the host, or for non-Docker setups.
# DB_HOST='127.0.0.1'
# DB_PREFIX='wp_'
# DB_SSL=true   # Required for Azure Database for MySQL

# Optionally use a DSN instead of the individual DB_* variables
# DATABASE_URL='mysql://user:password@host:3306/database'

WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# AI provider: "azure", "gemini", "demo" (sample answers, no AI service), or
# empty to use the first configured one. AI features are disabled until a
# provider is configured.
AI_PROVIDER=''

# Demo mode: only administrators can open wp-admin; other users stay in the app.
# JALASUPPORT_DEMO=false

# AI access: only this site's own UI can use the AI by default (browser session,
# same origin). Set to true to also allow API clients with application passwords.
# AI_ALLOW_API_CLIENTS=false
# Site-wide AI requests per day (protects the provider quota and costs)
# AI_DAILY_LIMIT=200

# Google Gemini (key from https://aistudio.google.com/apikey)
# Free-tier keys: Google may use submitted content to improve its products,
# so use test data only. Use a paid key for real customer tickets.
GEMINI_API_KEY=''
# Models: use free-tier Flash models. The defaults are Google's "latest"
# aliases, which keep working when pinned versions are retired. Pro/premium
# models have no free tier. The fallback is tried once when the primary model
# times out, is overloaded (503) or is out of quota (429); "none" disables it.
# GEMINI_MODEL='gemini-flash-lite-latest'
# GEMINI_FALLBACK_MODEL='gemini-flash-latest'
# GEMINI_TIMEOUT=20                 # seconds per attempt (5-25)

# Azure OpenAI (optional; AI features are disabled until configured)
# Endpoint format: https://<resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=''
AZURE_OPENAI_API_KEY=''
AZURE_OPENAI_DEPLOYMENT=''
# AZURE_OPENAI_API_VERSION='2024-10-21'
# Use the App Service managed identity instead of an API key
# AZURE_OPENAI_USE_MANAGED_IDENTITY=false
# AZURE_OPENAI_TIMEOUT=30

# Docker Compose (optional)
# Image / tool versions (defaults shown)
# PHP_VERSION=8.5
# COMPOSER_VERSION=2.11.2
# WP_CLI_VERSION=2.12.0
# MYSQL_VERSION=8.4
# PHPMYADMIN_VERSION=5.2
# APP_PORT=8080
# DB_PORT=3306
# PMA_PORT=8081
# HOST_UID=1000
# HOST_GID=1000
