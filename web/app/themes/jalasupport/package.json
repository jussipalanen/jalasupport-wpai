{
    "name": "jalasupport-theme",
    "private": true,
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "translate": "npm run translate:pot && npm run translate:update",
        "translate:pot": "wp i18n make-pot . ./resources/lang/jalasupport.pot --include=\"theme.json,patterns,app,resources\"",
        "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/jalasupport.pot $file; done",
        "translate:compile": "npm run translate:mo && npm run translate:js",
        "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
        "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@roots/vite-plugin": "^2.0.0",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "alpinejs": "^3.17.5"
    }
}
