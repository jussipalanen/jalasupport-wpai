#!/usr/bin/env bash
#
# JalaSupport AI development helper.
# Thin wrapper around Docker Compose and the common project commands.
#
# Usage: ./dev <command> [args...]    (./dev help for the list)

set -euo pipefail

cd "$(dirname "$0")"

THEME_DIR="web/app/themes/jalasupport"
COMPOSE=(docker compose)

# Run a command inside the app container as www-data (TTY only when interactive).
app_exec() {
    local tty=()
    [ -t 0 ] && [ -t 1 ] || tty=(-T)
    "${COMPOSE[@]}" exec "${tty[@]}" -u www-data app "$@"
}

ensure_env() {
    if [ ! -f .env ]; then
        echo "No .env file found. Create one first: cp .env.example .env" >&2
        exit 1
    fi
}

env_value() {
    # Read a single value from .env without sourcing it.
    grep -E "^$1=" .env | tail -n1 | cut -d= -f2- | sed -e "s/^['\"]//" -e "s/['\"]$//"
}

usage() {
    cat <<'EOF'
JalaSupport AI development helper

Usage: ./dev <command> [args...]

Docker
    up                Start the stack in the background (builds on first run)
    down              Stop and remove the containers (database volume is kept)
    restart [svc]     Restart all services or one service (app, db)
    build             Rebuild the app image
    ps | status       Show service status
    logs [svc]        Follow logs (default: app)
    shell             Open a shell in the app container
    db [args]         MySQL shell, or run SQL: ./dev db -e "SHOW TABLES"
    reset             Stop the stack and DELETE the database volume (asks first)

Project
    setup             Install WordPress, activate ACF, Wordfence, plugin and theme
    composer <args>   Run Composer in the app container
    wp <args>         Run WP-CLI in the app container, e.g. ./dev wp plugin list
    test              Run the Pest test suite
    tickets export [--file=<path>] [--ids=<ids>]
                        Export local tickets as JSON (default: backups/tickets-<time>.json)
    tickets import <file> --author=<login> [--dry-run]
                        Import a ticket export (local or from ./dev azure export-tickets)
    lint [--fix]      Run all linters: Pint, PHPStan, ESLint, editorconfig (--fix auto-fixes)
    npm <args>        Run npm in the theme directory (on the host)
    assets            Install npm dependencies (root tooling + theme) and build assets
    vite              Start the Vite dev server for the theme
    demo [serve]      Run the Playground demo on http://127.0.0.1:9400 (in-browser
                        WordPress, sample tickets, demo AI; resets on stop)
    demo build        Only build the demo bundle in build/playground/

Production image (local test)
    prod [up]         Build and run the production image on http://localhost:8090 (local DB, TLS)
    prod down         Stop and remove the production test container
    prod logs         Follow the production test container logs

Azure (manual, nothing runs automatically; see docs/DEPLOYMENT.md)
    azure setup       Create or update the free-tier deployment (asks first)
    azure deploy      Build, push and roll out the current code
    azure status      Show the deployment state (read-only; --health wakes the app)
    azure domain [add <host> | update <host> | clean]
                        Custom domain with a free certificate (shows the DNS records first)
    azure github-oidc One-time access for the GitHub Actions Deploy workflow
    azure shell       Shell in the Azure container as www-data (--root for root)
    azure wp <args>   WP-CLI in the Azure container, e.g. ./dev azure wp plugin list
    azure export-tickets [--file=<path>] [--ids=<ids>]
                        Download the Azure tickets (default: backups/azure-tickets-<time>.json)
    azure import-tickets <file> --author=<login> [--dry-run]
                        Import a ticket export into Azure
    azure teardown    Delete the whole deployment (BACKUP=1 exports data first)
    Preview any of them without changes: DRY_RUN=1 ./dev azure setup

Releases (x.y.z tags, notes from CHANGELOG.md; see README.md#releasing)
    release prepare <x.y.z>  Bump versions and date the changelog on a release branch
    release tag <x.y.z>      Tag main and push it; the Release workflow publishes it
    release check [x.y.z]    Verify that the changelog and version headers agree
    release notes <x.y.z>    Print the release notes of a version
EOF
}

command="${1:-help}"
shift || true

case "$command" in
    up)
        ensure_env
        "${COMPOSE[@]}" up -d "$@"
        echo "Application: $(env_value WP_HOME || echo http://localhost:8080)"
        ;;
    down)
        "${COMPOSE[@]}" down "$@"
        ;;
    restart)
        "${COMPOSE[@]}" restart "$@"
        ;;
    build)
        "${COMPOSE[@]}" build "$@"
        ;;
    ps | status)
        "${COMPOSE[@]}" ps "$@"
        ;;
    logs)
        "${COMPOSE[@]}" logs -f "${@:-app}"
        ;;
    shell)
        app_exec bash
        ;;
    db)
        # MySQL client as the application user; extra arguments go to mysql,
        # e.g. ./dev db -e "SHOW TABLES". MYSQL_PWD keeps the password off the command line.
        ensure_env
        tty=()
        [ -t 0 ] && [ -t 1 ] || tty=(-T)
        # shellcheck disable=SC2016  # $MYSQL_* must expand inside the db container
        "${COMPOSE[@]}" exec "${tty[@]}" db sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" exec mysql -u"$MYSQL_USER" "$MYSQL_DATABASE" "$@"' mysql "$@"
        ;;
    reset)
        read -r -p "This deletes the local database volume. Continue? [y/N] " answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            "${COMPOSE[@]}" down -v
        else
            echo "Aborted."
        fi
        ;;
    setup)
        ensure_env
        url="$(env_value WP_HOME)"
        if app_exec wp core is-installed 2>/dev/null; then
            echo "WordPress is already installed."
        else
            read -r -p "Admin username [admin]: " admin_user
            read -r -p "Admin email [admin@example.com]: " admin_email
            app_exec wp core install \
                --url="${url:-http://localhost:8080}" \
                --title="JalaSupport AI" \
                --admin_user="${admin_user:-admin}" \
                --admin_email="${admin_email:-admin@example.com}" \
                --prompt=admin_password
        fi
        app_exec wp plugin activate advanced-custom-fields wordfence jalasupport
        # Wordfence disables application passwords by default; the REST API
        # documents them for API clients, so keep them enabled (HTTPS only).
        app_exec wp eval 'if (class_exists("wfConfig")) { wfConfig::set("loginSec_disableApplicationPasswords", 0); }'
        app_exec wp theme activate jalasupport
        app_exec wp rewrite structure '/%postname%/' --hard
        ;;
    composer)
        app_exec composer "$@"
        ;;
    wp)
        app_exec wp "$@"
        ;;
    test)
        app_exec composer test -- "$@"
        ;;
    tickets)
        # Paths are relative to the project root (mounted in the container).
        case "${1:-}" in
            export)
                shift
                case " $* " in
                    *" --file="*) ;;
                    *)
                        mkdir -p backups
                        set -- "--file=backups/tickets-$(date +%Y%m%d-%H%M%S).json" "$@"
                        ;;
                esac
                app_exec wp jalasupport tickets export "$@"
                ;;
            import)
                shift
                app_exec wp jalasupport tickets import "$@"
                ;;
            *)
                echo "Usage: ./dev tickets export [--file=<path>] [--ids=<ids>] | import <file> --author=<login> [--dry-run]" >&2
                exit 1
                ;;
        esac
        ;;
    lint)
        if [ "${1:-}" = "--fix" ]; then
            app_exec composer lint:fix
            (cd "$THEME_DIR" && npm run lint:fix)
        fi
        app_exec composer lint
        app_exec composer analyse
        (cd "$THEME_DIR" && npm run lint)
        npm run lint:editorconfig
        echo "All linters passed."
        ;;
    npm)
        (cd "$THEME_DIR" && npm "$@")
        ;;
    assets)
        npm install
        (cd "$THEME_DIR" && npm install && npm run build)
        ;;
    vite)
        (cd "$THEME_DIR" && npm run dev)
        ;;
    prod)
        ensure_env
        prod_name="jalasupport-prod"
        prod_port="${PROD_PORT:-8090}"
        case "${1:-up}" in
            up)
                docker build --target prod -t jalasupport-app:prod -f docker/php/Dockerfile .
                "${COMPOSE[@]}" up -d db
                # shellcheck disable=SC2016  # Go template for docker inspect, not a shell expansion
                network="$("${COMPOSE[@]}" ps -q db | xargs docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}')"
                docker rm -f "$prod_name" > /dev/null 2>&1 || true
                # Same database and salts as local development, production settings.
                docker run -d --name "$prod_name" --network "$network" \
                    -p "127.0.0.1:${prod_port}:80" \
                    --env-file .env \
                    -e DB_HOST=db -e DB_SSL=true -e WP_ENV=production \
                    -e WP_HOME="http://localhost:${prod_port}" \
                    -e WP_SITEURL="http://localhost:${prod_port}/wp" \
                    jalasupport-app:prod > /dev/null
                echo "Production image running: http://localhost:${prod_port} (stop with ./dev prod down)"
                ;;
            down)
                docker rm -f "$prod_name"
                ;;
            logs)
                docker logs -f "$prod_name"
                ;;
            *)
                echo "Usage: ./dev prod [up|down|logs]" >&2
                exit 1
                ;;
        esac
        ;;
    azure)
        # Thin wrappers around scripts/azure/*.sh (same prompts, DRY_RUN=1 supported).
        case "${1:-help}" in
            setup | deploy | status | domain | teardown | github-oidc)
                script="scripts/azure/${1}.sh"
                shift
                exec "$script" "$@"
                ;;
            shell | wp)
                exec scripts/azure/exec.sh "$@"
                ;;
            export-tickets | import-tickets)
                mode="${1%-tickets}"
                shift
                exec scripts/azure/tickets.sh "$mode" "$@"
                ;;
            help | -h | --help)
                usage | sed -n '/^Azure/,/DRY_RUN=1 \.\/dev azure setup/p'
                ;;
            *)
                echo "Unknown azure command: $1" >&2
                usage | sed -n '/^Azure/,/DRY_RUN=1 \.\/dev azure setup/p' >&2
                exit 1
                ;;
        esac
        ;;
    release)
        exec scripts/release.sh "$@"
        ;;
    demo)
        exec scripts/playground.sh "${@:-serve}"
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        echo >&2
        usage >&2
        exit 1
        ;;
esac
