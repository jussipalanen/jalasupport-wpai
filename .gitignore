# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
# Wordfence runtime data and optional extended-protection firewall files
web/app/wflogs/
web/wordfence-waf.php
web/.user.ini

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# JalaSupport application code (tracked despite the plugin ignore rule above)
!web/app/plugins/jalasupport/

# Node
node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store

# PHPStan
.phpstan-cache/

# Azure deployment: local settings, generated secrets and backups
scripts/azure/config.env
scripts/azure/.state.env
backups/
