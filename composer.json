{
    "name": "jalasupport/jalasupport-ai",
    "type": "project",
    "license": "proprietary",
    "description": "JalaSupport AI - AI-assisted customer support and ticket management built on WordPress and Roots.",
    "keywords": [
        "wordpress",
        "bedrock",
        "sage",
        "acorn",
        "support",
        "tickets",
        "azure-openai"
    ],
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "oscarotero/env": "^2.0",
        "roots/acorn": "^6.0",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "7.1.5",
        "roots/wp-config": "^1.0",
        "vlucas/phpdotenv": "^5.0",
        "wp-plugin/advanced-custom-fields": "^6.8",
        "wp-plugin/wordfence": "^9.1"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "web/app/themes/jalasupport/app/",
            "JalaSupport\\": "web/app/plugins/jalasupport/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Stubs/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wp"
    },
    "scripts": {
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ],
        "lint": "pint --test config tests web/app/plugins/jalasupport web/app/themes/jalasupport/app web/app/themes/jalasupport/functions.php",
        "lint:fix": "pint config tests web/app/plugins/jalasupport web/app/themes/jalasupport/app web/app/themes/jalasupport/functions.php",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    }
}
